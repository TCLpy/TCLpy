DEBUG:root:text_before_cursor: 'set a 10\nset b 3\n\n# Basic arithmetic\nset sum [expr {$a + $b}]\nset product [expr {$a * $b}]\n\nputs "Sum: $sum, Product: $product"\n# Output: Sum: 13, Product: 30\n'
DEBUG:asyncio:Using proactor: IocpProactor
DEBUG:root:text_before_cursor: 'proc addNumbers {x y} {\n    return [expr {$x + $y}]\n}\n\nset result [addNumbers 15 25]\nputs "The sum is $result"\n# Output: The sum is 40\n'
DEBUG:asyncio:Using proactor: IocpProactor
DEBUG:root:text_before_cursor: 'set score 85\n\nif {$score >= 90} {\n    puts "Grade: A"\n} elseif {$score >= 75} {\n    puts "Grade: B"\n} else {\n    puts "Grade: C"\n}\n\n# For loop\nfor {set i 0} {$i < 3} {incr i} {\n    puts "Iteration $i"\n}\n\n# Foreach loop over a list\nforeach item {apple banana cherry} {\n    puts "Fruit: $item"\n}\n'
DEBUG:asyncio:Using proactor: IocpProactor
DEBUG:root:text_before_cursor: '# Create a list\nset colors [list red green blue]\nputs "Second color: [lindex $colors 1]"\n# Output: Second color: green\n\n# Write to and read from a file\nset fp [open "test.txt" w]\nputs $fp "Writing a line to Tcl file handling."\nclose $fp\n\nset fp [open "test.txt" r]\nset line [gets $fp]\nclose $fp\nputs "Read from file: $line"\n'
